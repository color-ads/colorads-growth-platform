# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://elkjtxelbhtnvgertupz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic (IA analista mensual)
ANTHROPIC_API_KEY=your_anthropic_key_here

# SerpAPI (opcional): datos verificados de Google Ads Transparency en el research de competencia.
# Sin esta key, el research funciona igual usando solo el web_search de Anthropic (fallback).
# En produccion hay que cargarla tambien en las env vars de Vercel.
SERPAPI_KEY=your_serpapi_key_here

# Resend (emails)
RESEND_API_KEY=your_resend_key_here
RESEND_FROM_EMAIL=reportes@colorads.co

# Google Ads API (analisis de audiencia real). Opcional: sin estas vars, el panel
# de Audiencias muestra "no configurado" y nada se rompe.
# El REFRESH_TOKEN se genera con: node scripts/google-ads-token.mjs
# Los IDs van SIN guiones (10 digitos). En produccion, cargar las 6 en Vercel.
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_MCC_ID=your_mcc_id
GOOGLE_ADS_H98_CUSTOMER_ID=your_h98_customer_id

# Meta Business Manager
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Cloudbeds
CLOUDBEDS_CLIENT_ID=your_cloudbeds_client_id
CLOUDBEDS_CLIENT_SECRET=your_cloudbeds_client_secret

# App
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXT_PUBLIC_APP_URL=http://localhost:3000
